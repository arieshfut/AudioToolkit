<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base MD2 dark theme -->
    <style name="Theme.Audiotools" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary -->
        <item name="colorPrimary">@color/primary_light</item>
        <item name="colorPrimaryVariant">@color/primary</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary -->
        <item name="colorSecondary">@color/secondary_light</item>
        <item name="colorSecondaryVariant">@color/secondary</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Surface -->
        <item name="colorSurface">#FF1E1E1E</item>
        <item name="colorOnSurface">#FFE0E0E0</item>
        <!-- Background -->
        <item name="android:colorBackground">#FF121212</item>
        <item name="colorOnBackground">#FFE0E0E0</item>
        <!-- Error -->
        <item name="colorError">#FFEF5350</item>
        <item name="colorOnError">@color/black</item>
        <!-- System bars -->
        <item name="android:statusBarColor">#FF0D0D0D</item>
        <item name="android:navigationBarColor">#FF0D0D0D</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
</resources>
